# --- Server ---
PORT=4000

# --- MySQL connection (matches what you use in MySQL Workbench) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=nvs_international

# --- Security ---
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_string

# --- Admin account (created/updated when you run: npm run seed) ---
ADMIN_USERNAME=Ganeshreddy
ADMIN_PASSWORD=set_a_strong_password_here

# --- Which website origins may call this API (comma-separated) ---
CORS_ORIGIN=http://127.0.0.1:8000,http://localhost:8000
